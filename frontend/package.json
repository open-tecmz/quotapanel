{
  "name": "quotapanel-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @quotapanel/ui dev",
    "build": "pnpm --filter @quotapanel/ui build",
    "build:quota": "pnpm --filter @quotapanel/quota build",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue,css}\"",
    "lint": "eslint \"packages/*/src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,vue}\" --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.5.3"
  }
}
